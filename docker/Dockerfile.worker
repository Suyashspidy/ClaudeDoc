# Celery worker — same base as API, separate container for job processing
FROM rocm/pytorch:rocm7.0_ubuntu22.04_py3.10_pytorch_2.6.0

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    tesseract-ocr \
    tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt \
    --extra-index-url https://download.pytorch.org/whl/rocm7.0

COPY backend/ ./backend/
COPY config/ ./config/
COPY .env .env

RUN mkdir -p uploads reports cache

ENV PYTHONPATH=/app
# MI300X (gfx942/CDNA3) is natively supported in ROCm 6.0+ — no GFX override needed

CMD ["celery", "-A", "backend.app.worker.celery_app", "worker", \
     "--loglevel=info", "--concurrency=2", "-Q", "celery"]
